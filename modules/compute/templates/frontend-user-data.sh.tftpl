#!/bin/bash
# Frontend startup script. EC2 runs it once, as root, on the instance's first boot.
# Terraform fills in $${environment} (dev, staging or prod) before the script is sent to AWS.
# Log of this script on the instance: /var/log/cloud-init-output.log
set -euxo pipefail

# 1. Install the nginx web server
dnf install -y nginx

# 2. Read this instance's details from the metadata service (IMDSv2 needs a token)
TOKEN=$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
INSTANCE_ID=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/instance-id)
AZ=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/placement/availability-zone)
PRIVATE_IP=$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
DEPLOYED_AT=$(date -u +"%Y-%m-%d %H:%M UTC")

# 3. Write a simple test page (replaces nginx's default page)
cat > /usr/share/nginx/html/index.html <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>${environment} frontend is running</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0;
           display: flex; min-height: 100vh; margin: 0; align-items: center; justify-content: center; }
    .card { background: #1e293b; padding: 32px 40px; border-radius: 12px; max-width: 520px; }
    h1 { margin-top: 0; color: #38bdf8; }
    td { padding: 6px 16px 6px 0; }
    td:first-child { color: #94a3b8; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Hello from ${environment}</h1>
    <p>This page is served by nginx on an EC2 instance built with Terraform.</p>
    <table>
      <tr><td>Environment</td><td>${environment}</td></tr>
      <tr><td>Instance ID</td><td>$INSTANCE_ID</td></tr>
      <tr><td>Availability Zone</td><td>$AZ</td></tr>
      <tr><td>Private IP</td><td>$PRIVATE_IP</td></tr>
      <tr><td>Deployed at</td><td>$DEPLOYED_AT</td></tr>
    </table>
  </div>
</body>
</html>
HTML

# 4. Start nginx now and on every reboot
systemctl enable --now nginx